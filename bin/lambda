#!/usr/bin/env php
<?php

declare(strict_types=1);

use Temporal\Lambda\Runtime;

$autoloaders = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];

foreach ($autoloaders as $autoload) {
    if (\is_file($autoload)) {
        require $autoload;

        Runtime::main();
    }
}

\fwrite(\STDERR, 'Composer autoloader not found, looked in: ' . \implode(', ', $autoloaders) . "\n");

exit(1);
